# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# For local development or mock mode, these can be set to placeholders or left blank to use local mock database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Single-Owner Authentication (Security restriction: only this email can log in)
OWNER_EMAIL=owner@yourbusiness.com

# Gemini AI API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth 2.0 & Gmail API Configuration
# Create OAuth 2.0 credentials in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Security & Encryption
# Must be a 32-byte hex string (64 hex characters) or 32-byte base64 string for AES-256-GCM
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret token required to trigger the background worker endpoint POST /api/jobs/process
# Supabase Cron or external cron should include this in: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=super-secret-cron-token-change-in-production

# Unsubscribe HMAC signing secret (uses APP_ENCRYPTION_KEY if not specified)
UNSUBSCRIBE_SECRET=

# Outreach & Scheduling Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_DAILY_SEND_LIMIT=10
DEFAULT_MAX_FOLLOWUPS=2

# Mock Mode (Set to true or 1 to force mock modes for Gemini and Gmail without real API keys)
MOCK_MODE=false
